[Desktop Entry]
Type=Application
Name=Rill
GenericName=Web Browser
Comment=A small, quiet native WebKit browser for Linux
Exec=search --url %u
Icon=search
Terminal=false
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;
StartupNotify=true
StartupWMClass=search
Keywords=web;browser;privacy;vertical tabs;WebKit;Rill;
