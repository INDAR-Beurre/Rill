<component type="desktop-application">
  <id>io.github.indar_beurre.Search</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Search</name>
  <summary>A small, quiet vertical-tab browser for Linux</summary>
  <description>
    <p>Search is a Rust and WebKitGTK browser with vertical tabs, a single address field, reading mode and local-first history.</p>
    <p>It uses the shared WebKit engine rather than bundling Chromium.</p>
  </description>
  <launchable type="desktop-id">Search.desktop</launchable>
  <url type="homepage">https://github.com/INDAR-Beurre/search-linux</url>
  <url type="bugtracker">https://github.com/INDAR-Beurre/search-linux/issues</url>
  <developer_name>Search Linux contributors</developer_name>
  <content_rating type="oars-1.1"/>
